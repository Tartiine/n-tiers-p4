@page "/game/{gameId:int}"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="container mt-4">
    <h3 class="text-center text-primary mb-4">Connect 4</h3>

    @if (game == null && errorMessage == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        @if (errorMessage != null)
        {
            <div class="alert alert-danger mt-3" role="alert">
                @errorMessage
            </div>
        }

        <div class="card shadow-lg border-0 mb-4">
            <div class="card-body">
                <p><strong>Game ID:</strong> @game.Id</p>
                <p><strong>Host:</strong> <span class="text-success">@game.HostName</span></p>
                <p><strong>Guest:</strong> <span class="text-primary">@game.GuestName</span></p>
            </div>
        </div>

        <div class="game-info mt-3 text-center">
            <h5 class="mb-3">Current Turn: 
                <span class="badge @(game.CurrentTurnId == game.HostId ? "bg-success" : "bg-primary")">
                    @(game.CurrentTurnId == game.HostId ? game.HostName : game.GuestName)
                </span>
            </h5>
        </div>

        <div class="grid-container">
            @if (game.Grid == null)
            {
                <p class="text-danger">Grid is null. Please check if the server response includes the grid.</p>
            }
            else if (game.Grid.Cells == null || game.Grid.Cells.Count == 0)
            {
                <p class="text-danger">
                    Grid data is missing or invalid.
                    Rows: @game.Grid.Rows, Columns: @game.Grid.Columns, Cell Count: @game.Grid.Cells?.Count
                </p>
            }
            else
            {
                <div class="connect-four-grid">
                    @for (int row = 0; row < game.Grid.Rows; row++)
                    {
                        <div class="grid-row">
                            @for (int col = 0; col < game.Grid.Columns; col++)
                            {
                                var currentCol = col; 
                                var index = row * game.Grid.Columns + currentCol;
                                var cell = game.Grid.Cells[index];

                                <div class="grid-cell" data-column="@currentCol" @onclick="() => PlayTurn(currentCol)">
                                    <div class="token" style="background-color: @(cell.Token?.Color ?? "white")"></div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
@code {
    [Parameter]
    public int gameId { get; set; }

    private GameDto game;
    private string errorMessage;

    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            int currentPlayerId = await GetCurrentPlayerId();
            Console.WriteLine($"Fetching game details for game ID: {gameId}");

            var jsonResponse = await Http.GetStringAsync($"api/game/{gameId}");
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };
            var response = JsonSerializer.Deserialize<ApiResponse<GameDto>>(jsonResponse, options);

            if (response?.Success == true && response.Data != null)
            {
                game = response.Data; 
                Console.WriteLine($"Game loaded successfully: ID={game.Id}, Current Turn ID={game.CurrentTurnId}");
                if (currentPlayerId != game.HostId && currentPlayerId != game.GuestId)
                {
                    Console.WriteLine($"Player {currentPlayerId} is not part of the game. Redirecting to login.");
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
            }
            else
            {
                errorMessage = response?.Message ?? "Failed to load game data.";
                Console.WriteLine($"Error: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while loading the game.";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }


    private async Task<int> GetCurrentPlayerId()
    {
        var playerId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "PlayerId");
        if (int.TryParse(playerId, out int id))
        {
            return id;
        }
        throw new Exception("PlayerId not found in local storage");
    }

    private async Task PlayTurn(int column)
    {
        if (isSubmitting) return; 
        isSubmitting = true;

        try
        {
            int currentPlayerId = await GetCurrentPlayerId();
            Console.WriteLine($"Current Player ID: {currentPlayerId}, Current Turn ID: {game?.CurrentTurnId}");

            if (currentPlayerId != game?.CurrentTurnId)
            {
                errorMessage = "It's not your turn!";
                Console.WriteLine(errorMessage);
                return;
            }

            Console.WriteLine($"Player {currentPlayerId} is attempting to play in column: {column}");

            var response = await Http.PostAsJsonAsync($"api/game/{gameId}/playTurn", new PlayTurnRequest
            {
                PlayerId = currentPlayerId,
                Column = column
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<GameDto>>();
                if (result?.Success == true)
                {
                    game = result.Data;
                    errorMessage = null;
                    Console.WriteLine($"Turn played successfully. Current Turn ID: {game.CurrentTurnId}, Game Status: {game.Status}");
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to play the turn.";
                    Console.WriteLine($"Error: {errorMessage}");
                }
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<GameDto>>();
                if (result?.Message != null)
                {
                    errorMessage = result.Message;
                }
                else
                {
                    errorMessage = $"Server returned error code: {response.StatusCode}.";
                }
                Console.WriteLine($"Error: {errorMessage}");
            }

        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while playing the turn.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}