@page "/list"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3 class="text-center my-3">My Games</h3>

@if (isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (games == null || !games.Any())
{
    <p class="text-center text-muted">No games available.</p>
}
else
{
    <div class="list-group">
        @foreach (var game in games)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>Game @game.Id</strong><br />
                    <span><strong>Host:</strong> @game.HostName</span><br />
                    <span><strong>Guest:</strong> @game.GuestName</span><br />
                    <span><strong>Status:</strong> @game.Status</span>
                </div>
                <div class="d-flex">
                    <button class="btn btn-primary me-2" @onclick="() => JoinOrCreateGame(game.Id)">Join</button>
                </div>
            </div>
        }
    </div>
}

<div class="text-center mt-4">
    <button class="btn btn-success" @onclick="() => JoinOrCreateGame(null)">Create Game</button>
</div>

@code {
    private List<GameDto> games = new();
    private string errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadGames();
    }

    private async Task<int> GetCurrentPlayerId()
    {
        // Retrieve PlayerId from local storage
        var playerId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "PlayerId");
        if (int.TryParse(playerId, out int id))
        {
            return id;
        }
        throw new Exception("PlayerId not found in local storage");
    }

    private async Task LoadGames()
    {
        isLoading = true;
        try
        {
            games = await Http.GetFromJsonAsync<List<GameDto>>("api/game");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching games: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task JoinOrCreateGame(int? gameId = null)
    {
        try
        {
            Console.WriteLine("Attempting to retrieve PlayerId...");
            int currentPlayerId = await GetCurrentPlayerId();
            Console.WriteLine($"Retrieved PlayerId: {currentPlayerId}");

            string url = gameId.HasValue
                ? $"api/game/joinOrCreate?gameId={gameId.Value}&hostId={currentPlayerId}"
                : $"api/game/joinOrCreate?hostId={currentPlayerId}";

            Console.WriteLine($"Generated request URL: {url}");

            var response = await Http.GetFromJsonAsync<ApiResponse<GameDto>>(url);

            if (response?.Success == true && response.Data != null)
            {
                Console.WriteLine($"Game joined or created successfully. Game ID: {response.Data.Id}");
                Navigation.NavigateTo($"/game/{response.Data.Id}");
            }
            else
            {
                errorMessage = response?.Message ?? "Failed to join or create game.";
                Console.WriteLine($"Error: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while creating or joining the game.";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }



    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; }
        public T Data { get; set; }
    }

    public class GameDto
    {
        public int Id { get; set; }
        public string HostName { get; set; }
        public string GuestName { get; set; }
        public string Status { get; set; }
    }
}
